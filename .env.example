SECUREPR_HOST=127.0.0.1
SECUREPR_PORT=8080
SECUREPR_DB_PATH=securepr.db
SECUREPR_MAX_DIFF_BYTES=1048576
SECUREPR_MAX_STEPS=8
SECUREPR_TIMEOUT_SECONDS=120

# Login is secure-by-default. Use a random 32+ byte value in production.
SECUREPR_AUTH_REQUIRED=true
SECUREPR_AUTH_SECRET=
SECUREPR_BOOTSTRAP_ADMIN_USERNAME=
SECUREPR_BOOTSTRAP_ADMIN_PASSWORD=
SECUREPR_DEFAULT_TENANT_ID=default
SECUREPR_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
SECUREPR_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
SECUREPR_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
SECUREPR_OPENROUTER_API_KEY=
SECUREPR_OPENROUTER_SITE_URL=
SECUREPR_OPENROUTER_APP_NAME=SecurePR Agent

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
SECUREPR_LLM_BASE_URL=
SECUREPR_LLM_API_KEY=
SECUREPR_LLM_MODEL=

# Replay evaluation and evolution activation gate
SECUREPR_EVAL_MAX_CASES=5
SECUREPR_EVAL_MIN_CASES=3
SECUREPR_EVAL_MIN_HOLDOUT_CASES=2
SECUREPR_EVAL_MIN_IMPROVEMENT=0.01
SECUREPR_EVAL_MAX_METRIC_REGRESSION=0

# GitHub integration
SECUREPR_GITHUB_WEBHOOK_SECRET=
SECUREPR_GITHUB_TOKEN=
SECUREPR_AUTO_POST_REVIEW=false
SECUREPR_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
SECUREPR_DATABASE_URL=
SECUREPR_POSTGRES_PASSWORD=
SECUREPR_REDIS_URL=
SECUREPR_ASYNC_WORKERS=2
SECUREPR_QUEUE_MAX_ATTEMPTS=3
SECUREPR_QUEUE_LEASE_SECONDS=60
SECUREPR_SKILLS_DIR=skills
SECUREPR_SKILL_SANDBOX=true
SECUREPR_SKILL_TIMEOUT_SECONDS=30
SECUREPR_SKILL_MEMORY_MB=256
SECUREPR_SKILL_SIGNING_KEY=

# Repair verification and observability
SECUREPR_REPAIR_TEST_COMMAND=
SECUREPR_REPAIR_VERIFY_TIMEOUT_SECONDS=120
SECUREPR_OTEL_ENDPOINT=
SECUREPR_OTEL_SERVICE_NAME=securepr
SECUREPR_ALERT_FAILURE_RATE=0.20
SECUREPR_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
SECUREPR_GITHUB_APP_ID=
SECUREPR_GITHUB_APP_SLUG=
SECUREPR_GITHUB_PRIVATE_KEY_PATH=
SECUREPR_PUBLIC_BASE_URL=http://127.0.0.1:8080
